NODE_ENV=development
HOST=127.0.0.1
PORT=8323
DATABASE_URL=postgresql://auth_bff:change-me@127.0.0.1:5432/auth_bff
AUTH_ORIGIN=http://localhost:3000
# 额外放行的浏览器入口，逗号分隔。localhost 与 127.0.0.1 是浏览器眼里两个不同的
# Origin，而校验是精确字符串匹配：只填 localhost 会让从 http://127.0.0.1:3000
# 访问的写请求（钱包挑战/校验、OIDC 起跳）全部 403 invalid_origin。
# 生产环境留空——公网入口只应保留规范域名一个 Origin。
AUTH_ORIGINS=http://127.0.0.1:3000
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
# Production: 84532. Local Compose/CI may use 31337.
SIWE_CHAIN_ID=84532
RETURN_TO_ORIGINS=http://localhost:3000
TRUST_PROXY=false
COOKIE_SECURE=false
COOKIE_NAME=auth_session
SESSION_TTL_SECONDS=604800
CHALLENGE_TTL_SECONDS=300
OIDC_FLOW_TTL_SECONDS=600
# Providers fail closed until credentials are complete.
# Google / Apple / Casdoor 需要 issuer + client id + client secret + redirect URI 四项齐全。
GOOGLE_OIDC_ISSUER=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=
# GitHub 是纯 OAuth 2.0（无 issuer、无 id_token），只需 client id + client secret + redirect URI。
# 在 https://github.com/settings/developers 创建 OAuth App，回调填下面的 REDIRECT_URI。
GITHUB_OIDC_CLIENT_ID=
GITHUB_OIDC_CLIENT_SECRET=
GITHUB_OIDC_REDIRECT_URI=
APPLE_OIDC_ISSUER=
APPLE_OIDC_CLIENT_ID=
APPLE_OIDC_CLIENT_SECRET=
APPLE_OIDC_REDIRECT_URI=
CASDOOR_OIDC_ISSUER=
CASDOOR_OIDC_CLIENT_ID=
CASDOOR_OIDC_CLIENT_SECRET=
CASDOOR_OIDC_REDIRECT_URI=

# External agent identity gateway (L2/L3 binding). Leave empty to disable attestation writes.
AGENT_REGISTRY_ADDRESS=
AGENT_REGISTRY_RPC_URL=
IDENTITY_VERIFIER_PRIVATE_KEY=
